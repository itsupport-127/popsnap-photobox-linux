#!/bin/sh
set -e
DATA=/var/lib/popsnap
case "$1" in
  upgrade)
    OLD="$2"; NEW="@VERSION@"
    if dpkg --compare-versions "$NEW" lt "$OLD" && [ "${POPSNAP_ALLOW_DOWNGRADE:-0}" != "1" ]; then
      echo "POPSNAP: ditolak, terpasang $OLD, paket ini $NEW (lebih lama). Sengaja? POPSNAP_ALLOW_DOWNGRADE=1 sudo -E dpkg -i ..." >&2; exit 1
    fi
    systemctl stop popsnap 2>/dev/null || true
    if [ -f "$DATA/db/popsnap.db" ]; then
      B="$DATA/backup/sebelum-update-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$B"
      cp -p "$DATA"/db/popsnap.db* "$B"/ 2>/dev/null || true
      echo "POPSNAP: cadangan database di $B"
    fi;;
esac
exit 0
