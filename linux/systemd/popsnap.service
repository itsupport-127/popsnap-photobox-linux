[Unit]
Description=POPSNAP photobooth (backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=popsnap
Group=popsnap
EnvironmentFile=-/etc/popsnap/popsnap.conf
ExecStart=/opt/popsnap/bin/popsnap-start
Restart=on-failure
RestartSec=3
StateDirectory=popsnap
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
