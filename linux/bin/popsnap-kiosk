#!/bin/sh
# Membuka tampilan booth di Chrome/Chromium mode kiosk (layar penuh). Dijalankan di sesi desktop booth (autostart),
# bukan sebagai layanan. Chrome dibuka ulang otomatis kalau tertutup/crash.
#   popsnap-kiosk          mulai
#   popsnap-kiosk --stop   hentikan (dan jangan dibuka ulang)
set -u
[ -r /etc/popsnap/popsnap.conf ] && . /etc/popsnap/popsnap.conf
: "${PORT:=4000}"
: "${KIOSK_URL:=http://localhost:$PORT/}"
: "${KIOSK_AUTO_CAMERA:=1}"      # 1 = izin kamera diberikan otomatis (tanpa pop-up) di profil kiosk
: "${KIOSK_SILENT_PRINT:=1}"     # 1 = cetak langsung ke printer bawaan (CUPS) tanpa dialog
: "${KIOSK_EXTRA_FLAGS:=}"
STOP="${XDG_RUNTIME_DIR:-/tmp}/popsnap-kiosk.stop"
PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/popsnap-kiosk"

if [ "${1:-}" = "--stop" ]; then
  : > "$STOP"; pkill -f "user-data-dir=$PROFILE" 2>/dev/null; echo "Kiosk dihentikan."; exit 0
fi
rm -f "$STOP"

BROWSER="${CHROME_BIN:-}"
if [ -z "$BROWSER" ]; then
  for b in google-chrome-stable google-chrome chromium chromium-browser; do
    command -v "$b" >/dev/null 2>&1 && { BROWSER="$b"; break; }
  done
fi
[ -n "$BROWSER" ] || { echo "POPSNAP: Chrome/Chromium tidak ditemukan. Pasang salah satunya, atau isi CHROME_BIN di /etc/popsnap/popsnap.conf." >&2; exit 127; }

# Tunggu backend siap (maks ±90 dtk)
i=0
while [ "$i" -lt "${KIOSK_WAIT_TRIES:-45}" ]; do
  if command -v curl >/dev/null 2>&1; then curl -fsS -o /dev/null "http://localhost:$PORT/api/settings/public" 2>/dev/null && break
  else sleep 5; break; fi
  i=$((i+1)); sleep 2
done

mkdir -p "$PROFILE"
FLAGS="--kiosk --user-data-dir=$PROFILE --no-first-run --no-default-browser-check --noerrdialogs --disable-infobars
 --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 --autoplay-policy=no-user-gesture-required
 --disable-features=Translate --check-for-update-interval=31536000"
[ "$KIOSK_AUTO_CAMERA" = "1" ] && FLAGS="$FLAGS --use-fake-ui-for-media-stream"
[ "$KIOSK_SILENT_PRINT" = "1" ] && FLAGS="$FLAGS --kiosk-printing"

while :; do
  # shellcheck disable=SC2086
  "$BROWSER" $FLAGS $KIOSK_EXTRA_FLAGS "$KIOSK_URL"
  [ -e "$STOP" ] && exit 0
  # hapus penanda "tidak ditutup dengan benar" supaya Chrome tidak menampilkan pesan pemulihan
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"Crashed"/"exit_type":"Normal"/' "$PROFILE/Default/Preferences" 2>/dev/null
  sleep 3
done
